<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProbActivity">

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:text="Principais Problemas"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Quais são os 3 principais problemas da cidade?"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView6" />

    <RadioGroup
        android:id="@+id/rgProblemas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7">

        <CheckBox
            android:id="@+id/cbTransporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transporte"
            android:textSize="20sp" />

        <CheckBox
            android:id="@+id/cbSaude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saúde"
            android:textSize="20sp" />

        <CheckBox
            android:id="@+id/cbEducacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Educação"
            android:textSize="20sp" />

        <CheckBox
            android:id="@+id/cbSeguranca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Segurança pública"
            android:textSize="20sp" />

        <CheckBox
            android:id="@+id/cbEmprego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emprego"
            android:textSize="20sp" />

        <CheckBox
            android:id="@+id/cbInfra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Infraestrutura"
            android:textSize="20sp" />
    </RadioGroup>

    <Button
        android:id="@+id/btNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/button"
        android:text="Próximo"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:cornerRadius="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rgProblemas" />
</androidx.constraintlayout.widget.ConstraintLayout>